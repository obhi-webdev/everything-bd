# EverythingBD Private Page Index Control
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow" "expr=%{THE_REQUEST} =~ m#^[A-Z]+[[:space:]]+/(admin|checkout|order-success|lp)([/?[:space:]]|$)#i"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # EverythingBD Canonical Domain Redirect
  RewriteCond %{HTTP_HOST} ^www\.everything-bd\.com$ [NC]
  RewriteRule ^ https://everything-bd.com%{REQUEST_URI} [R=301,L,NE]

  # EverythingBD Dynamic Sitemap
  RewriteRule ^sitemap\.xml$ https://api.everything-bd.com/api/seo/sitemap.xml [R=302,L,NE,QSD]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>
